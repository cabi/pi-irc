{
  "name": "pi-irc",
  "version": "0.2.0",
  "description": "IRC as the communication bus for pi agents and humans: RFC 2812 client-side implementation with background bootstrap, roster, and one lean `irc` tool",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "irc",
    "rfc2812",
    "agent-communication",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://github.com/cabi/pi-irc.git"
  },
  "bugs": {
    "url": "https://github.com/cabi/pi-irc/issues"
  },
  "homepage": "https://github.com/cabi/pi-irc#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "lib/",
    "docs/example.pi-irc.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^26.6.6",
    "jiti": "^2.7.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  }
}
