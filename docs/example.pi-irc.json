{
	"server": {
		"host": "irc.example.net",
		"port": 6697,
		"tls": true,
		"passwordEnv": "PI_IRC_PASSWORD",
		"tlsInsecure": false,
		// "tlsCaFile": "~/.pi/agent/certs/irc.lan.pem"  // PEM of the internal CA / self-signed leaf — verified, not skipped
	},
	"auth": {
		"username": "pi-agent",
		"passwordEnv": "PI_IRC_SASL_PASSWORD"
	},
	"nick": {
		"template": "pi-{shortId}",
		"maxLen": 30
	},
	"channels": {
		"projectTemplate": "#pi-{slug}",
		"defaults": [],
		"autoCreate": true,
		"topicTemplate": "pi project {slug} — created {date}",
		"kickRejoinDelayMs": 3000
	},
	"capabilities": {
		"request": ["extended-join", "server-time", "away-notify"]
	},
	"delivery": {
		"bufferMax": 500,
		"wakeOnDirectMessage": true,
		"wakeAllowNicks": [],
		"chunkLongSends": true
	}
}
