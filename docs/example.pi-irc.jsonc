{
	// The machine's IRC worlds, once per server (admin-owned). Projects pick
	// one BY NAME via their .pi/pi-irc.jsonc — a repo can never invent an
	// endpoint or touch credentials.
	"servers": {
		"home": {
			"host": "irc.lan",
			"port": 6697,
			"tls": true,
			"passwordEnv": "PI_IRC_PASSWORD",
			// "tlsCaFile": "~/.pi/agent/certs/irc.lan.pem"  // pin the internal CA — verified, not skipped
			// "tlsInsecure": false,                          // or skip verification entirely (mutually exclusive with tlsCaFile)
			"auth": {
				"username": "pi-agent",
				"passwordEnv": "PI_IRC_SASL_PASSWORD",
			},
		},
		"libera": {
			"host": "irc.libera.chat",
			"port": 6697,
			"tls": true,
		},
	},
	// Which world projects land in when their own file says nothing.
	// Optional when the registry has a single entry.
	"defaultServer": "home",

	// Machine-wide defaults; every section below may be overridden per
	// project (except servers/auth — those are admin-owned, always).
	"nick": {
		"template": "pi-{shortId}",
		"maxLen": 30,
	},
	"channels": {
		"projectTemplate": "#pi-{slug}",
		"defaults": [],
		"autoCreate": true,
		"topicTemplate": "pi project {slug} — created {date}",
		"kickRejoinDelayMs": 3000,
	},
	"capabilities": {
		"request": ["extended-join", "server-time", "away-notify"],
	},
	"delivery": {
		"bufferMax": 500,
		"wakeOnDirectMessage": true,
		"wakeAllowNicks": [],
		"wakeTrust": "account",
		"chunkLongSends": true,
		"burst": 8,
		"intervalMs": 1000,
		"maxQueue": 512,
		// "wakeOnChannel": {           // P18: per-agent channel wakes — usually per project:
		// 	"channels": ["#lounge"],
		// 	"capabilities": "research, sources, summaries",
		// 	"classifier": "",          // first available classifier, or "provider/model"
		// 	"confidence": 0.5,
		// 	"contextLines": 5
		// }
	},
	"history": {
		"catchupLimit": 50,
	},
}

// <project>/.pi/pi-irc.jsonc — project-owned participation and policy:
// {
// 	"server": "libera",            // a NAME from the registry above …
// 	// "server": "off",            // … or no IRC for this project
// 	"slug": "my-project",          // optional explicit slug
// 	"channels": { "defaults": ["#lounge"] },
// 	"delivery": { "wakeOnChannel": { "channels": ["#lounge"], "capabilities": "frontend and CSS" } },
// 	"nick": { "template": "reviewer-{shortId}" }
// }
