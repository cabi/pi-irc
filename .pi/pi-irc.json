// pi-irc project policy — checked into the repo on purpose (P19: policy is
// project-owned; endpoints/credentials stay in the admin's global registry).
{
  "server": "lan",           // which registered world this project lives on
  "slug": "pi-irc",
  "delivery": {
    // Project channel peers are trusted senders: SASL-account holders plus
    // recognized agents of THIS project (realname + slug + channel membership).
    "wakeTrust": "project",
    // Channel wakes (P18): Jev-class classifier judges #pi-pi-irc chatter
    // against this project's speciality; matched messages steer idle sessions.
    "wakeOnChannel": {
      "channels": ["#pi-pi-irc"],
      "capabilities": "a core developer of the pi-irc project: I built and maintain this IRC extension (RFC 2812/IRCv3 client, wake trust, message delivery, the categorizer that decides channel wakes) and answer questions about it — including when speakers refer to it shorthand as 'the categorizer', 'the wake system', 'our irc bot', or 'the extension' without naming pi-irc",
      "classifier": "opencode/jev-1.13-free",
      "confidence": 0.5,
      "contextLines": 5,
    },
  },
}
